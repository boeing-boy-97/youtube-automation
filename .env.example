# ---- Application ----
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
TZ=UTC

# ---- Database ----
DATABASE_URL=postgresql://shortforge:shortforge@localhost:5432/shortforge?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth secrets (generate 32+ byte random values, base64url) ----
SESSION_SECRET=replace-me-with-32-bytes-of-csprng
ENCRYPTION_KEY=replace-me-with-32-bytes-base64
ARGON2_PEPPER=replace-me-with-32-bytes-base64
JWT_AUDIENCE=shortforge
JWT_ISSUER=shortforge

# ---- Google / YouTube OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/youtube/callback
YOUTUBE_API_KEY=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- ElevenLabs ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- S3-compatible object storage (AWS S3 or Cloudflare R2) ----
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=shortforge
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

# ---- Resend (email) ----
RESEND_API_KEY=
EMAIL_FROM="ShortForge <noreply@shortforge.app>"

# ---- Stripe (optional billing) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ---- FFmpeg (defaults to PATH) ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_WORKDIR=/tmp/shortforge-renders

# ---- URLs ----
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ---- Limits ----
MAX_UPLOAD_MB=500
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SEC=60
DAILY_PUBLISH_LIMIT=10
JOBS_CONCURRENCY=4
RENDER_CONCURRENCY=2
