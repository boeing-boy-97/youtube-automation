{
  "name": "shortforge-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ShortForge autonomous short-form content production backend — production",
  "type": "module",
  "engines": { "node": ">=20.10.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "WORKER_API_DISABLED=true tsx watch src/workers/run-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/run-worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "close-with-grace": "^2.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "elevenlabs": "^0.18.0",
    "fastify": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.2",
    "nanoid": "^5.0.9",
    "openai": "^4.73.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "redlock": "^5.0.0-beta.2",
    "resend": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
